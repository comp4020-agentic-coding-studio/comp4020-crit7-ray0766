---
import Base from "../layouts/Base.astro";
import { DEMO_PLAN_ID } from "../lib/seed";
import { labelSession, planSessions } from "../lib/sessions";

// The front door: what this is, and one form that starts a plan. Plans are
// not listed anywhere — a plan's URL is the only way to it.
const starts = planSessions("2026-S1", 4);
---

<Base
  title="Tally"
  description="A study planner for the ANU Master of Computing: see what ANUHub would say before enrolment day."
>
  <div class="home">
    <div>
      <h1>Plan the ANU Master of Computing before enrolment day.</h1>
      <p class="lede">
        Put courses into semesters. Tally tells you what ANUHub would say when you press
        enrol — requisite not met, incompatible, not offered, over the load — and keeps a
        running count of how many of the program's 96 units your plan counts towards, line
        by line.
      </p>
    </div>

    <form method="post" action="/api/plans" class="start">
      <label>
        Plan name
        <input name="name" maxlength="80" placeholder="My MComp plan" autocomplete="off" />
      </label>
      <label>
        First semester
        <select name="start">
          {starts.map((s) => <option value={s}>{labelSession(s)}</option>)}
        </select>
      </label>
      <button class="btn btn--primary">Start a plan</button>
    </form>

    <p class="fine">
      No login. A plan's link is its only identity — keep it.{" "}
      <a href={`/plan/${DEMO_PLAN_ID}`}>Open the demo plan →</a>
    </p>
  </div>
</Base>
